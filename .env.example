# ==============================================================================
# Enterprise Document Intelligence RAG System - Environment Configuration
# ==============================================================================

# LLM Provider: "gemini" | "openai" | "ollama" | "mock"
# Default is "mock" for zero-configuration, offline testing and CI/CD pipelines.
LLM_PROVIDER=mock

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Embedding Configuration
# Uses HuggingFace sentence-transformers locally
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Default Chunking Hyperparameters
DEFAULT_CHUNK_SIZE=600
DEFAULT_CHUNK_OVERLAP=100

# Retrieval & Reranker Settings
DEFAULT_TOP_K=4
ENABLE_RERANKING=true
RERANKER_TOP_N=3
SIMILARITY_THRESHOLD=0.25

# Strict Grounding & Hallucination Guardrails
STRICT_GROUNDING=true
